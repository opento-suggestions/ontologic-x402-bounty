# ─── Hedera testnet operator (ORG operational key — the ONE ORG key, W-2) ───
# TESTNET ONLY — never a mainnet key. NEVER commit the real .env (.gitignore covers it).
OPERATOR_ID=0.0.XXXXXXX
OPERATOR_DER_KEY=<your-der-encoded-private-key>
OPERATOR_HEX_KEY=<your-hex-private-key>
OPERATOR_EVM_ADDR=0x0000000000000000000000000000000000xxxxxx

# ─── Network (testnet only — a mainnet URL hard-fails via assertTestnet) ───
MIRROR_NODE_URL=https://testnet.mirrornode.hedera.com/api/v1
HEDERA_RPC_URL=https://testnet.hashio.io/api

# ─── Live v0.8.3 sphere (READ ONLY — this build never writes to these) ───
RULE_DEFS_TOPIC_ID=0.0.8641938
RULE_REGISTRY_TOPIC_ID=0.0.8641941
PROOF_TOPIC_ID=0.0.8641943

# ─── Witness Required — LIVE public coordinates (testnet, created 2026-07-19) ───
# These are public entity IDs, not secrets — pre-filled so a fresh clone can
# stamp Lane A with nothing but its own PAYER_* below. ORG re-deployments
# overwrite them via the creation scripts.
WITNESS_HBAR_TOPIC_ID=0.0.9645621
WITNESS_KEY_TOPIC_ID=0.0.9645622
VENDING_CONTRACT_ID=0.0.9645863
VENDING_CONTRACT_ADDR=0x0000000000000000000000000000000000932f27
WITNESS_KEY_TOKEN_ID=0.0.9645864
# Circle testnet USDC (mirror-confirmed; leave empty for HBAR exact-scheme fallback)
USDC_TOKEN_ID=0.0.429274

# ─── Phase 2 authority layer (LIVE — one-shot ceremony executed 2026-07-27) ───
# There are TWO ORG keys (W-11 two-key structure) — root writes mandates,
# operator renders verdicts, disjoint powers. The two topics below are public
# trust anchors (immutable at birth, admin_key null forever); they are also
# pinned in packages/core/src/anchors.ts, which is what verification uses.
WITNESS_RULES_TOPIC=0.0.9794232
WITNESS_VERDICT_TOPIC=0.0.9794234
# ORG-side only — root key and mandate state live in ORG's .env, never here.
# (Pre-filled topic IDs above also make the creation scripts' single-shot
# guards refuse to run from a fresh clone, which is correct.)
ROOT_ID=
ROOT_DER_KEY=
WITNESS_MANDATE_HASH=
WITNESS_FIRST_MANDATE_TS=

# ─── witness-mcp (the payer-agent's plugin — distinct from OPERATOR *and* ROOT, W-2) ───
# YOUR OWN funded testnet account (free at portal.hedera.com). This is the
# only thing a fresh clone must fill to stamp Lane A.
PAYER_ID=
PAYER_DER_KEY=
# The live literal-402 gateway (leave empty to build requirements locally)
WITNESS_REQUIREMENTS_URL=https://www.ontologic.dev/x402/vend
# Optional facilitator for the conformant partially-signed flow
FACILITATOR_URL=
