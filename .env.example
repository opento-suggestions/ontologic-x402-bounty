# ─── Hedera testnet operator (ORG operational key — the ONE ORG key, W-2) ───
# TESTNET ONLY — never a mainnet key. NEVER commit the real .env (.gitignore covers it).
OPERATOR_ID=0.0.XXXXXXX
OPERATOR_DER_KEY=<your-der-encoded-private-key>
OPERATOR_HEX_KEY=<your-hex-private-key>
OPERATOR_EVM_ADDR=0x0000000000000000000000000000000000xxxxxx

# ─── Network (testnet only — a mainnet URL hard-fails via assertTestnet) ───
MIRROR_NODE_URL=https://testnet.mirrornode.hedera.com/api/v1
HEDERA_RPC_URL=https://testnet.hashio.io/api

# ─── Live v0.8.3 sphere (READ ONLY — this build never writes to these) ───
RULE_DEFS_TOPIC_ID=0.0.8641938
RULE_REGISTRY_TOPIC_ID=0.0.8641941
PROOF_TOPIC_ID=0.0.8641943

# ─── Witness Required (filled by scripts as they run) ───
# scripts/create-topics.ts →
WITNESS_HBAR_TOPIC_ID=
WITNESS_KEY_TOPIC_ID=
# packages/contracts deploy →
VENDING_CONTRACT_ID=
VENDING_CONTRACT_ADDR=
# scripts/create-key-token.ts →
WITNESS_KEY_TOKEN_ID=
# V-1 desk study → testnet USDC (or leave empty for HBAR exact-scheme fallback)
USDC_TOKEN_ID=

# ─── Phase 2 authority layer (ceremony §3 — HUMAN-GATED scripts fill these) ───
# The header above lies by one now: there are TWO ORG keys (W-11 two-key
# structure) — root writes mandates, operator renders verdicts, disjoint powers.
# scripts/create-root.ts →
ROOT_ID=
ROOT_DER_KEY=
# scripts/create-authority-topics.ts → (immutable at birth — admin_key null forever)
WITNESS_RULES_TOPIC=
WITNESS_VERDICT_TOPIC=
# scripts/grant-mandate.ts →
WITNESS_MANDATE_HASH=
WITNESS_FIRST_MANDATE_TS=

# ─── witness-mcp (the payer-agent's plugin — distinct from OPERATOR *and* ROOT, W-2) ───
# scripts/create-payer.ts →
PAYER_ID=
PAYER_DER_KEY=
# The live literal-402 gateway (leave empty to build requirements locally)
WITNESS_REQUIREMENTS_URL=https://www.ontologic.dev/x402/vend
# Optional facilitator for the conformant partially-signed flow
FACILITATOR_URL=
